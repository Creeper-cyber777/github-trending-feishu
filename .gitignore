# 依赖与构建产物
node_modules/
npm-debug.log*
pnpm-debug.log*

# 密钥文件 —— 绝对不要提交
# 只忽略真实的本地配置，.env.js（加载器）与 .env.example（模板）必须提交
.env
.env.local
.env.local.*
.env.*.local
!.env.example
!.env.js
*.key
*.pem
secrets.*

# 运行时归档产物
输出/
artifact/
archive/
logs/
card-*.json
GitHub热门_*.md

# 注意：.trending-state/ 必须提交。
# 它是"今天是否已推送"的去重状态，靠提交回仓库在多次运行间共享。

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
