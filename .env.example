# 服务配置示例 —— 复制为 .env.local 并填入真实值（.env.local 已被 .gitignore 排除）
# 提示：本地开发时填这里；GitHub Actions 运行时从仓库 Secrets 注入，不使用此文件。

# 智谱开放平台 API Key（https://open.bigmodel.cn）
ZHIPU_API_KEY=

# 飞书自定义机器人 Webhook
FEISHU_WEBHOOK=

# 飞书机器人开启「签名校验」时才需要填，否则留空
FEISHU_SECRET=

# 可选：覆盖默认模型
ZHIPU_MODEL=glm-4-flash

# 可选：抓取周期 daily / weekly / monthly
TRENDING_SINCE=daily

# 可选：推送条数
TRENDING_LIMIT=10
